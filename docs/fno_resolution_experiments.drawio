    <mxCell id="e_exp1_exp2" value="best level" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;strokeColor=#C2410C;strokeWidth=2;endArrow=block;endFill=1;fontColor=#C2410C;fontSize=12;" edge="1" parent="1" source="exp1Group" target="exp2Group"><mxGeometry relative="1" as="geometry"/></mxCell>
