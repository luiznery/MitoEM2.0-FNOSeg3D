      <mxGeometry x="30" y="245" width="420" height="40" as="geometry"/>
    </mxCell>
    <mxCell id="test2same" value="Test at training level" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#14213D;strokeColor=none;fontColor=#F7F6F1;fontSize=13;" vertex="1" parent="exp2Group">
