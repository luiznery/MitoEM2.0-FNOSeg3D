    </mxCell>
    <mxCell id="curve" value="&lt;b&gt;Read-out: learning curve&lt;/b&gt;&lt;br&gt;accuracy vs. N, per model, same-level and cross-level&lt;br&gt;→ smallest N reaching 95 % of full-data accuracy&lt;br&gt;→ does cross-level need more data than same-level?" style="rounded=1;whiteSpace=wrap;html=1;align=left;spacingLeft=10;fillColor=#FFFFFF;strokeColor=#DCD9CF;fontColor=#14213D;fontSize=12;" vertex="1" parent="exp2Group">
      <mxGeometry x="30" y="310" width="700" height="90" as="geometry"/>
    </mxCell>
    <mxCell id="readout2" value="&lt;b&gt;Metrics (both experiments)&lt;/b&gt;: AP@0.5, AP@0.75, PQ · foreground Dice as diagnostic · split by instance size (small ones vanish at coarse levels)" style="rounded=1;whiteSpace=wrap;html=1;align=left;spacingLeft=10;fillColor=#14213D;strokeColor=none;fontColor=#F7F6F1;fontSize=12;" vertex="1" parent="exp2Group">
      <mxGeometry x="30" y="430" width="700" height="55" as="geometry"/>
