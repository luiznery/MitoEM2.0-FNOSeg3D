    <mxCell id="n1" value="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#14213D;strokeColor=none;fontColor=#F7F6F1;fontSize=14;fontStyle=1;" vertex="1" parent="exp2Group">
