    <mxCell id="n16" value="16" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#6B9BC3;strokeColor=none;fontColor=#F7F6F1;fontSize=14;fontStyle=1;" vertex="1" parent="exp2Group">
